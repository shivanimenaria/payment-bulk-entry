# Runtime
RDASH_API_URL=
RDASH_APP_URL=
RDASH_PBE_TAB_CODE=
RDASH_CLIENT_ID=
RDASH_CLIENT_KID=
RDASH_CLIENT_ALG=
RDASH_CLIENT_PRIVATE_KEY_PEM=
# 64 hex chars, unique to PBE. Generate: openssl rand -hex 32
# Required in every mode — the server exits at startup if missing/invalid.
COOKIE_SECRET=
# mock | real (required)
RDASH_DATA_SOURCE=
# Mock only — comma-separated payment_request_ids to force-fail (rejected with real)
MOCK_FAIL_IDS=
# "true" ONLY for an intentional demo deployment running mock mode under
# NODE_ENV=production (next start / Docker). Leave unset everywhere else.
PBE_ALLOW_MOCK_IN_PRODUCTION=
# ── DEV ONLY: static-token mode (test against the real rDash API before the
# embedded app is registered). Refused under NODE_ENV=production. No handover,
# no refresh; ids are sent to rDash exactly as given. Never commit real values
# — put them in .env.local (git-ignored). The token is never logged.
# Unset (or "handover") = normal embedded flow.
RDASH_AUTH_MODE=
# Your rDash API token and its scheme (Authorization: "<scheme> <token>").
RDASH_DEV_API_TOKEN=
RDASH_DEV_AUTH_SCHEME=
# rDash's own vendor hashid (the `id` from GET /v2/vendors) — not PBE-salt encoded.
RDASH_DEV_VENDOR_ID=
# "true" to allow the bulk POST (real payment entries!). Unset = writes blocked (403).
RDASH_DEV_ALLOW_WRITES=

# NO LONGER NEEDED — remove: config now returns project_id (Swagger corrected).
# TEMPORARY — remove when config returns project_id.
# Project hashid (same form as config ids) used for the details call of config
# rows that have no project_id; those rows are marked "(temporary)".
# Refused under NODE_ENV=production unless ALLOW_TEMP_PROJECT_ID=true.
RDASH_TEMP_PROJECT_ID=
ALLOW_TEMP_PROJECT_ID=

# Build + runtime
APP_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_RDASH_UI_ORIGIN=
